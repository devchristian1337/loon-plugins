#!name = Spotify
#!desc = Removes Spotify ads and unlocks some premium features. Audio quality cannot be set to Very High. Optional: hide the discovery feed on the Now Playing screen, the membership info in Settings and the AI DJ. Log in again after enabling the plugin to apply the full configuration.
#!openUrl = https://loon-plugins.vercel.app
#!author = devchristian1337
#!tag = Spotify, AdBlock, Premium
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!homepage = https://github.com/devchristian1337/loon-plugins/blob/main/README.md
#!icon = https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/spotify.png
#!date = 2026-11-10

[Argument]
spot_remote_config = switch,false,tag=Remote config modification,desc=Alternative protobuf patch of the bootstrap/customize responses that only edits the flags sent by the server. When off (recommended) the local config override is used: a Premium configuration snapshot matching the app version (9.1.76 and newer, or older). Only one of the two runs, never both
hide_discovery_feed = switch,true,tag=Hide discovery feed,desc=Hides the discovery feed shown on the Now Playing screen
hide_membership_info = switch,true,tag=Hide membership info,desc=Hides the membership info in Settings (display only)
hide_ai_dj = switch,true,tag=Hide AI DJ,desc=Blocks the AI DJ entry so it does not appear in the app

[Rule]
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT

DOMAIN,aet.spotify.com,REJECT

[Rewrite]
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del if-none-match
# Since app 9.1.98 the configuration and the account attributes are refreshed through these two endpoints; without the conditional header the server answers 304 and the app keeps its unpatched cache.
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$ header-del if-none-match
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon reject-dict
# Ad delivery endpoints used by the player core and the Home banner (ads/*, ad-logic/*, ad-on-app-open) and the Premium upsell offers: a failed fetch makes the app skip the ad break.
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer) reject

# Optional preferences, each controlled by its own switch (conditional rewrite syntax, Loon 3.5.1+)
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/watch-feed-entrypoints\/v\d\/discovery-from-seed/ && ${hide_discovery_feed} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/[\w-]+-spclient\.spotify\.com(?::443)?\/pam-view-service\// && ${hide_membership_info} == true then reject_dict(200)
request if ${url} ~= /37i9dQZF1EYkqdzj48dyYq/ && ${hide_ai_dj} == true then reject_dict(200)

[Mitm]
hostname = spclient.wg.spotify.com, *spclient.spotify.com

[Script]
http-request ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-gabo.js, timeout=10, tag=Spotify gabo

http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoSearchAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify search ads
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoHomeAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify home ads
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoScrollAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify scroll ads
# Only the first matching script runs for a response: the remote patch is listed first and runs only when its switch is on, otherwise the local override below handles the response.
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-proto-eevee.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify protobuf (remote), enable={spot_remote_config}
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify protobuf (local)
http-response ^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify protobuf (app 9.1.98+ configuration and attributes)
